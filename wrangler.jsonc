{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-ai-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },

  // D1 や vars は環境間で継承されないため、誤接続を防ぐ目的で各環境へ明記する。
  "env": {
    "local": {
      "name": "discord-ai-bot-local",
      "vars": { "ENVIRONMENT": "local" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "discord-ai-bot-local",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "triggers": { "crons": [] },
    },
    "preview": {
      "name": "discord-ai-bot-preview",
      "vars": { "ENVIRONMENT": "preview" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "discord-ai-bot-preview",
          // Codespaces で Preview D1 を作成した後に実 ID へ置換する。
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "triggers": { "crons": ["* * * * *"] },
    },
    "production": {
      "name": "discord-ai-bot-production",
      "vars": { "ENVIRONMENT": "production" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "discord-ai-bot-production",
          // 本番 ID はリポジトリへ事前投入せず、D1 作成時に置換する。
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "triggers": { "crons": ["* * * * *"] },
    },
  },
}
