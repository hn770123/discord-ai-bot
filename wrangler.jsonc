{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-ai-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  // Worker とリモート D1 は環境を分けず、このトップレベル設定だけを運用する。
  "vars": {
    "OPENAI_MODEL": "gpt-5-mini",
    "DEFAULT_TIMEZONE": "Asia/Tokyo",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discord-ai-bot",
      // D1 作成後、Wrangler が返した実 ID へ置換する。
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "triggers": { "crons": ["* * * * *"] },
}
